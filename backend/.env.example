DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-max

# 正式环境填写后端 HTTPS 公网地址，不带 /api/v1
# 示例：API_PUBLIC_BASE_URL=https://api.example.com
API_PUBLIC_BASE_URL=

# 微信小程序登录。正式上线必须填写，用于 wx.login code 换 openid。
WECHAT_APPID=your_wechat_mini_program_appid
WECHAT_APP_SECRET=your_wechat_mini_program_secret
AUTH_TOKEN_EXPIRE_DAYS=30

# 仅本地开发可改成 true；正式服务器保持 false。
ALLOW_DEV_LOGIN=false
DEV_OPENID=dev-openid

BAIDU_API_KEY=
BAIDU_SECRET_KEY=
