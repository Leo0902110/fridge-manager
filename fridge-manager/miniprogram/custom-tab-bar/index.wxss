/* custom-tab-bar/index.wxss */
/* 核心风格优化点：底部操作台采用保鲜盒胶囊底座，选中态使用主色柔雾青柠绿。 */

.tabbar-root {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding: 0 24rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: linear-gradient(180deg, rgba(248, 244, 233, 0) 0%, rgba(248, 244, 233, 0.86) 42%, #F8F4E9 100%);
  box-sizing: border-box;
}

.tabbar-shell {
  position: relative;
  display: flex;
  align-items: center;
  height: 118rpx;
  padding: 10rpx;
  border-radius: 30rpx;
  background: rgba(255, 253, 247, 0.97);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 16rpx 42rpx rgba(73, 80, 87, 0.12), inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
}

.tabbar-indicator {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  width: calc((100% - 20rpx) / 3);
  height: calc(100% - 20rpx);
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(149, 210, 179, 0.24) 0%, rgba(149, 210, 179, 0.16) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(149, 210, 179, 0.22);
  transition: transform 0.26s ease;
}

.tabbar-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 98rpx;
  color: #7A858E;
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.tabbar-item-pressed {
  opacity: 0.84;
  transform: scale(0.96);
}

.tabbar-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
  border-radius: 18rpx;
  background: rgba(233, 236, 239, 0.62);
  border: 1rpx solid rgba(173, 181, 189, 0.18);
  color: #7A858E;
  box-sizing: border-box;
  transition: transform 0.22s ease, background-color 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
}

.tabbar-symbol {
  font-size: 30rpx;
  font-weight: 780;
  line-height: 1;
}

.tabbar-item.active .tabbar-icon-wrap {
  transform: translateY(-2rpx);
  background: linear-gradient(135deg, #AEE0C4 0%, #95D2B3 100%);
  color: #FFFFFF;
  border-color: rgba(149, 210, 179, 0.50);
  box-shadow: 0 8rpx 18rpx rgba(149, 210, 179, 0.26);
}

.tabbar-item:nth-child(3).active .tabbar-icon-wrap {
  transform: translateY(-4rpx) scale(1.08);
}

.tabbar-item:nth-child(3) .tabbar-symbol {
  font-size: 34rpx;
}

.tabbar-item:nth-child(4) .tabbar-symbol {
  font-size: 28rpx;
}

.tabbar-text {
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #7A858E;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.2;
  transition: color 0.22s ease, font-weight 0.22s ease;
}

.tabbar-item.active .tabbar-text {
  color: #5FAE86;
  font-weight: 800;
}