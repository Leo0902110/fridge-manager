.tabbar-root {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 20rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: linear-gradient(180deg, rgba(242, 242, 247, 0) 0%, rgba(242, 242, 247, 0.92) 30%, rgba(242, 242, 247, 1) 100%);
  box-sizing: border-box;
}

.tabbar-shell {
  position: relative;
  display: flex;
  align-items: stretch;
  height: 112rpx;
  padding: 8rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.12);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.tabbar-indicator {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: calc((100% - 16rpx) / 3);
  height: calc(100% - 16rpx);
  border-radius: 26rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.86) 0%, rgba(223, 239, 255, 0.95) 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.14);
  transition: transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tabbar-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8E8E93;
  transition: transform 0.18s ease;
}

.tabbar-item-pressed {
  transform: scale(0.96);
}

.tabbar-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 4rpx;
  border-radius: 18rpx;
  transform: translateY(0) scale(1);
  opacity: 0.84;
  transition: transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.32s ease, box-shadow 0.32s ease, opacity 0.24s ease;
}

.tabbar-item.active .tabbar-icon-wrap {
  transform: translateY(-4rpx) scale(1.12);
  opacity: 1;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 18rpx rgba(90, 200, 250, 0.2);
  animation: tabbar-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tabbar-icon {
  width: 42rpx;
  height: 42rpx;
  transform: scale(1);
  transition: transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.24s ease;
}

.tabbar-item.active .tabbar-icon {
  transform: scale(1.05);
}

.tabbar-text {
  font-size: 20rpx;
  font-weight: 500;
  opacity: 0.76;
  transform: translateY(0);
  transition: color 0.28s ease, transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.24s ease;
}

.tabbar-item.active .tabbar-text {
  color: #007AFF;
  opacity: 1;
  transform: translateY(2rpx);
}

@keyframes tabbar-pop {
  0% {
    transform: translateY(0) scale(0.96);
  }

  55% {
    transform: translateY(-5rpx) scale(1.14);
  }

  100% {
    transform: translateY(-4rpx) scale(1.12);
  }
}