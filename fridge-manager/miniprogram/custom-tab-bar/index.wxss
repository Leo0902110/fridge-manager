.tabbar-root {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 24rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: linear-gradient(180deg, rgba(242, 242, 247, 0) 0%, rgba(242, 242, 247, 0.86) 42%, #F2F2F7 100%);
  box-sizing: border-box;
}

.tabbar-shell {
  position: relative;
  display: flex;
  align-items: center;
  height: 118rpx;
  padding: 10rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 42rpx rgba(17, 24, 39, 0.13);
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  box-sizing: border-box;
}

.tabbar-indicator {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  width: calc((100% - 20rpx) / 3);
  height: calc(100% - 20rpx);
  border-radius: 24rpx;
  background: linear-gradient(180deg, #EFF7FF 0%, #E7F2FF 100%);
  box-shadow: inset 0 0 0 1rpx rgba(0, 122, 255, 0.08);
  transition: transform 0.26s ease;
}

.tabbar-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 98rpx;
  color: #8E8E93;
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.tabbar-item-pressed {
  transform: scale(0.96);
  opacity: 0.82;
}

.tabbar-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 6rpx;
  border-radius: 50%;
  background: rgba(142, 142, 147, 0.1);
  color: #8E8E93;
  box-sizing: border-box;
  transition: transform 0.22s ease, background-color 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
}

.tabbar-symbol {
  font-size: 30rpx;
  font-weight: 760;
  line-height: 1;
}

.tabbar-item.active .tabbar-icon-wrap {
  transform: translateY(-2rpx);
  background: #007AFF;
  color: #FFFFFF;
  box-shadow: 0 8rpx 18rpx rgba(0, 122, 255, 0.26);
}

.tabbar-item:nth-child(3).active .tabbar-icon-wrap {
  transform: translateY(-4rpx) scale(1.08);
}

.tabbar-item:nth-child(3) .tabbar-symbol {
  font-size: 34rpx;
}

.tabbar-item:nth-child(4) .tabbar-symbol {
  font-size: 28rpx;
}

.tabbar-text {
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 600;
  color: #8E8E93;
  line-height: 1.2;
  transition: color 0.22s ease, font-weight 0.22s ease;
}

.tabbar-item.active .tabbar-text {
  color: #007AFF;
  font-weight: 700;
}
