/* app.wxss - 全局样式 */
/* 核心风格优化点：统一「轻氧家居治愈风」变量，所有页面复用这些色彩、圆角与柔光阴影。 */

page {
  --primary-color: #95D2B3;
  --primary-deep: #5FAE86;
  --primary-soft: #EAF6EF;
  --success-color: #A7D676;
  --warning-color: #F5B86E;
  --danger-color: #D86464;
  --bg-color: #F8F4E9;
  --card-bg: #FFFDF7;
  --surface-muted: #F2EEDF;
  --surface-soft: #FBF8EF;
  --neutral-light: #E9ECEF;
  --neutral-mid: #ADB5BD;
  --text-primary: #495057;
  --text-secondary: #7A858E;
  --border-radius: 20rpx;
  --radius-soft: 18rpx;
  --shadow: 0 14rpx 34rpx rgba(73, 80, 87, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  --soft-shadow: 0 12rpx 28rpx rgba(149, 210, 179, 0.18);
  --cell-border: rgba(173, 181, 189, 0.22);
  min-height: 100%;
  background-color: var(--bg-color);
  background-image:
    radial-gradient(circle at 14% 8%, rgba(149, 210, 179, 0.20) 0, rgba(149, 210, 179, 0) 210rpx),
    radial-gradient(circle at 86% 2%, rgba(245, 184, 110, 0.16) 0, rgba(245, 184, 110, 0) 240rpx),
    linear-gradient(180deg, #FBF8EF 0%, #F8F4E9 52%, #F5F0E3 100%);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 34rpx;
  color: var(--text-primary);
  line-height: 1.4;
}

button::after {
  border: none;
}

button {
  color: var(--text-primary);
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.tab-page {
  padding-bottom: 180rpx;
}

/* 保鲜盒式通用卡片：20rpx 大圆角 + 柔光内阴影，后续页面只需要复用 .card。 */
.card {
  position: relative;
  overflow: hidden;
  margin-bottom: 32rpx;
  padding: 32rpx;
  border-radius: var(--border-radius);
  background: linear-gradient(180deg, rgba(255, 253, 247, 0.98) 0%, rgba(250, 247, 238, 0.96) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: var(--shadow);
  box-sizing: border-box;
}

.card::before {
  content: "";
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.86);
}

.list-group {
  overflow: hidden;
  margin-bottom: 32rpx;
  border-radius: var(--border-radius);
  background: var(--card-bg);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: var(--shadow);
}

.list-cell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 28rpx 32rpx;
  background: rgba(255, 253, 247, 0.96);
  box-sizing: border-box;
}

.list-cell:active {
  background-color: #F2EEDF;
}

.list-cell::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 0;
  left: 32rpx;
  height: 1px;
  background-color: var(--cell-border);
}

.list-cell:last-child::after {
  display: none;
}

.list-main {
  flex: 1;
  min-width: 0;
}

.list-title {
  display: block;
  font-size: 32rpx;
  font-weight: 650;
  color: var(--text-primary);
}

.list-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.right-meta {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.chevron {
  margin-left: 16rpx;
  font-size: 34rpx;
  color: var(--neutral-mid);
}

/* 按钮统一圆角与悬浮软阴影，点击用轻微缩放反馈。 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  border: none;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
  box-sizing: border-box;
  transition: opacity 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
}

.btn:active {
  opacity: 0.86;
  transform: scale(0.975);
}

.btn[disabled] {
  opacity: 0.48;
}

.btn-primary {
  background: linear-gradient(135deg, #AEE0C4 0%, #95D2B3 54%, #75BD98 100%);
  color: #FFFFFF;
  box-shadow: var(--soft-shadow);
}

.btn-success {
  background: linear-gradient(135deg, #BCE28E 0%, #A7D676 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 26rpx rgba(167, 214, 118, 0.24);
}

.btn-warning {
  background: linear-gradient(135deg, #FFD49A 0%, #F5B86E 100%);
  color: #FFFFFF;
}

.btn-danger {
  background: linear-gradient(135deg, #E58383 0%, #D86464 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 26rpx rgba(216, 100, 100, 0.20);
}

.btn-outline {
  background: rgba(149, 210, 179, 0.12);
  border: 2rpx solid rgba(149, 210, 179, 0.35);
  color: var(--primary-deep);
  box-shadow: none;
}

.page-subtitle {
  display: block;
  margin-bottom: 32rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.refresh-state {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(149, 210, 179, 0.18);
  color: var(--primary-deep);
  font-size: 22rpx;
  font-weight: 700;
}

.refresh-state.loading {
  background: rgba(245, 184, 110, 0.20);
  color: #A76420;
}

.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: 650;
}

.large-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--text-primary);
  font-size: 68rpx;
  font-weight: 780;
  letter-spacing: 1rpx;
}

.title,
.section-title {
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.muted-caption {
  color: var(--text-secondary);
  font-size: 24rpx;
}

.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }

/* 圆角柔边表单：内阴影模拟家居软质输入区，复用于添加页与弹层编辑页。 */
.field-group {
  padding: 24rpx;
  border-radius: var(--border-radius);
  background: rgba(242, 238, 223, 0.66);
  box-shadow: inset 0 2rpx 10rpx rgba(73, 80, 87, 0.04);
}

.field-row {
  margin-bottom: 24rpx;
}

.field-row:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 650;
}

.field-control,
.field-picker,
.field-textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx 28rpx;
  border-radius: 18rpx;
  background: #FFFDF7;
  border: 1rpx solid rgba(173, 181, 189, 0.22);
  box-shadow: inset 0 3rpx 10rpx rgba(73, 80, 87, 0.045);
  box-sizing: border-box;
  color: var(--text-primary);
  font-size: 30rpx;
}

.field-textarea {
  min-height: 180rpx;
}

.field-helper {
  display: block;
  margin-top: 12rpx;
  color: var(--primary-deep);
  font-size: 24rpx;
}

.pill-group {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.pill-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 168rpx;
  min-height: 72rpx;
  margin: 8rpx;
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: #FFFDF7;
  border: 2rpx solid var(--neutral-light);
  box-sizing: border-box;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 650;
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.pill-option:active {
  opacity: 0.84;
  transform: scale(0.98);
}

.pill-option.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #AEE0C4 0%, #95D2B3 100%);
  border-color: rgba(149, 210, 179, 0.60);
  box-shadow: 0 8rpx 18rpx rgba(149, 210, 179, 0.22);
}

.action-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.half-btn {
  width: 48%;
}

.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-12 { margin-right: 12rpx; }
.mr-16 { margin-right: 16rpx; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 32rpx;
}

.empty-state .icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 136rpx;
  margin-bottom: 24rpx;
  border-radius: 36rpx;
  background: rgba(149, 210, 179, 0.14);
  border: 3rpx solid rgba(149, 210, 179, 0.35);
  color: var(--primary-deep);
  font-size: 76rpx;
  box-shadow: inset 0 0 0 8rpx rgba(255, 253, 247, 0.70);
}

.empty-state .text {
  color: var(--text-secondary);
  font-size: 30rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading::before {
  content: "";
  width: 24rpx;
  height: 24rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: var(--primary-color);
  animation: freshBreath 1.2s ease-in-out infinite;
}

.loading-text {
  color: var(--text-secondary);
  font-size: 28rpx;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.status-fresh {
  background: rgba(167, 214, 118, 0.22);
  color: #507D28;
}

.status-warning {
  background: rgba(245, 184, 110, 0.24);
  color: #9A5A00;
}

.status-expired {
  background: rgba(216, 100, 100, 0.18);
  color: #9A3D3D;
}

@keyframes freshBreath {
  0%, 100% {
    opacity: 0.45;
    transform: scale(0.86);
  }
  50% {
    opacity: 1;
    transform: scale(1.12);
  }
}