/* app.wxss - 全局样式 */

page {
  --primary-color: #007AFF;
  --success-color: #34C759;
  --warning-color: #FF9500;
  --danger-color: #FF3B30;
  --text-primary: #111111;
  --text-secondary: #8E8E93;
  --bg-color: #F2F2F7;
  --card-bg: #FFFFFF;
  --surface-muted: #F8F8FC;
  --border-radius: 24rpx;
  --shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
  --cell-border: rgba(60, 60, 67, 0.12);
  background-color: var(--bg-color);
  min-height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 34rpx;
  color: var(--text-primary);
  line-height: 1.4;
}

button::after {
  border: none;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.tab-page {
  padding-bottom: 180rpx;
}

.card {
  background: var(--card-bg);
  border-radius: var(--border-radius);
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow);
  box-sizing: border-box;
}

.list-group {
  background: var(--card-bg);
  border-radius: var(--border-radius);
  margin-bottom: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.list-cell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: var(--card-bg);
  min-height: 96rpx;
  box-sizing: border-box;
}

.list-cell:active {
  background-color: #ECECF1;
}

.list-cell::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 32rpx;
  right: 0;
  height: 1px;
  background-color: var(--cell-border);
}

.list-cell:last-child::after {
  display: none;
}

.list-main {
  flex: 1;
  min-width: 0;
}

.list-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.list-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.right-meta {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.chevron {
  margin-left: 16rpx;
  font-size: 34rpx;
  color: #C7C7CC;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100rpx;
  border: none;
  border-radius: var(--border-radius);
  font-size: 34rpx;
  font-weight: 600;
  transition: opacity 0.2s;
}

.btn:active {
  opacity: 0.7;
}

.btn[disabled] {
  opacity: 0.45;
}

.btn-primary {
  background: var(--primary-color);
  color: #FFFFFF;
}

.btn-success {
  background: var(--success-color);
  color: #FFFFFF;
}

.btn-warning {
  background: var(--warning-color);
  color: #FFFFFF;
}

.btn-danger {
  background: var(--danger-color);
  color: #FFFFFF;
}

.btn-outline {
  background: #FFFFFF;
  border: 2rpx solid rgba(0, 122, 255, 0.22);
  color: var(--primary-color);
}

.page-subtitle {
  display: block;
  margin-bottom: 32rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.refresh-state {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.08);
  color: var(--primary-color);
  font-size: 22rpx;
  font-weight: 600;
}

.refresh-state.loading {
  background: rgba(255, 149, 0, 0.12);
  color: var(--warning-color);
}

.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: 600;
}

.large-title {
  display: block;
  font-size: 68rpx;
  font-weight: 750;
  margin-bottom: 8rpx;
  color: var(--text-primary);
}

.title,
.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.muted-caption {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.field-group {
  background: var(--surface-muted);
  border-radius: var(--border-radius);
  padding: 24rpx;
}

.field-row {
  margin-bottom: 24rpx;
}

.field-row:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.field-control,
.field-picker,
.field-textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-sizing: border-box;
  font-size: 30rpx;
  color: var(--text-primary);
}

.field-textarea {
  min-height: 180rpx;
}

.field-helper {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--primary-color);
}

.pill-group {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.pill-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 168rpx;
  margin: 8rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.pill-option.active {
  color: var(--primary-color);
  background: rgba(0, 122, 255, 0.08);
  border-color: rgba(0, 122, 255, 0.24);
}

.action-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.half-btn {
  width: 48%;
}

.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-12 { margin-right: 12rpx; }
.mr-16 { margin-right: 16rpx; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state .icon {
  font-size: 104rpx;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-fresh {
  background: #E8F5E9;
  color: #2E7D32;
}

.status-warning {
  background: #FFF3E0;
  color: #E67E22;
}

.status-expired {
  background: #FFEBEE;
  color: #C62828;
}
