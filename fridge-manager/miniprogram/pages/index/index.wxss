/* pages/index/index.wxss */

.page-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.page-subtitle-inline {
  margin-bottom: 0;
}

.refresh-state {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.08);
  color: var(--primary-color);
  font-size: 22rpx;
  font-weight: 600;
}

.refresh-state.loading {
  background: rgba(255, 149, 0, 0.12);
  color: var(--warning-color);
}

.hero-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #F7FAFF 100%);
}

.skeleton-card {
  background: #FFFFFF;
}

.skeleton-line,
.skeleton-avatar,
.skeleton-block {
  position: relative;
  overflow: hidden;
  background: #ECECF1;
}

.skeleton-line::after,
.skeleton-avatar::after,
.skeleton-block::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.7) 50%, rgba(255,255,255,0) 100%);
  animation: shimmer 1.4s infinite;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 999rpx;
}

.skeleton-line-small {
  width: 180rpx;
}

.skeleton-line-medium {
  width: 260rpx;
}

.skeleton-line-large {
  width: 140rpx;
  height: 72rpx;
  border-radius: 24rpx;
}

.skeleton-metrics {
  display: flex;
}

.skeleton-block {
  flex: 1;
  height: 96rpx;
  border-radius: 20rpx;
}

.skeleton-block:not(:last-child) {
  margin-right: 16rpx;
}

.skeleton-cell {
  align-items: center;
}

.skeleton-avatar {
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 50%;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.hero-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.hero-value {
  display: block;
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1;
}

.hero-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.1);
  color: var(--primary-color);
  font-size: 24rpx;
  font-weight: 600;
}

.hero-metrics {
  display: flex;
  padding-top: 24rpx;
  border-top: 1px solid var(--cell-border);
}

.metric-item {
  flex: 1;
  text-align: center;
}

.metric-item:not(:last-child) {
  border-right: 1px solid var(--cell-border);
}

.metric-value {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.metric-value.fresh {
  color: var(--success-color);
}

.metric-value.warning {
  color: var(--warning-color);
}

.metric-value.expired {
  color: var(--danger-color);
}

.metric-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.section-block {
  margin-bottom: 16rpx;
}

.action-dashboard {
  padding: 28rpx;
  background: #FFFFFF;
}

.action-header {
  padding: 0;
}

.expired-alert {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #FFF1F1;
  color: #B42318;
}

.expired-alert-title {
  font-size: 26rpx;
  font-weight: 750;
}

.action-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #F8FAFC;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  box-sizing: border-box;
}

.action-card:active {
  transform: scale(0.99);
  opacity: 0.86;
}

.action-warning {
  background: #FFF8EA;
}

.action-expired {
  background: #FFF1F1;
}

.action-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.action-icon {
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 42rpx;
}

.zero-waste {
  padding: 22rpx;
  border-radius: 20rpx;
  background: #F2F8F5;
}

.zero-waste-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #1F7A3B;
}

.zero-waste-text {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section-hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.inventory-header {
  align-items: flex-end;
}

.inventory-hint {
  margin-top: 6rpx;
}

.countdown-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 149, 0, 0.12);
  color: var(--warning-color);
  font-size: 24rpx;
  font-weight: 600;
}

.segmented-control {
  display: flex;
  padding: 4rpx;
  background: #E8E8ED;
  border-radius: 16rpx;
}

.quick-filter-scroll {
  margin: -4rpx 0 22rpx;
  white-space: nowrap;
}

.quick-filter-row {
  display: flex;
  padding: 0 8rpx;
}

.quick-chip {
  display: inline-flex;
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 650;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
}

.quick-chip.active {
  background: #EAF3FF;
  color: var(--primary-color);
  border-color: rgba(0, 122, 255, 0.22);
}

.segment-item {
  padding: 10rpx 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.segment-item.active {
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.risk-list {
  margin-bottom: 32rpx;
}

.risk-food-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 146rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
  overflow: hidden;
}

.risk-food-card:active {
  opacity: 0.84;
  transform: scale(0.99);
}

.risk-food-card:last-child {
  margin-bottom: 0;
}

.risk-expired {
  background: #FFF1F1;
  border-color: rgba(255, 59, 48, 0.28);
}

.risk-warning {
  background: #FFF8EA;
  border-color: rgba(255, 149, 0, 0.3);
}

.risk-fresh {
  background: #F0FAF3;
  border-color: rgba(52, 199, 89, 0.24);
}

.risk-light {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
}

.risk-expired .risk-light {
  background: #FF3B30;
}

.risk-warning .risk-light {
  background: #FF9500;
}

.risk-fresh .risk-light {
  background: #34C759;
}

.risk-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.risk-food-icon,
.risk-food-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 40rpx;
}

.risk-food-thumb {
  background: #FFFFFF;
}

.risk-copy {
  flex: 1;
  min-width: 0;
}

.risk-title {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 10rpx;
  font-size: 34rpx;
  font-weight: 760;
}

.risk-expired .risk-title {
  color: #A61B1B;
}

.risk-warning .risk-title {
  color: #9A5A00;
}

.risk-fresh .risk-title {
  color: #1F6F3A;
}

.risk-subtitle {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  color: rgba(17, 17, 17, 0.58);
}

.risk-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 18rpx;
}

.risk-date {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(17, 17, 17, 0.62);
}

.risk-countdown {
  margin-bottom: 10rpx;
  font-size: 26rpx;
  font-weight: 750;
}

.risk-expired .risk-countdown {
  color: #C62828;
}

.risk-warning .risk-countdown {
  color: #E67E22;
}

.risk-fresh .risk-countdown {
  color: #2E7D32;
}

.risk-badge {
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 750;
}

.risk-expired .risk-badge {
  background: #FF9DA0;
  color: #8B1A1A;
}

.risk-warning .risk-badge {
  background: #FFD591;
  color: #8A4B00;
}

.risk-fresh .risk-badge {
  background: #A9E8B8;
  color: #1B5E20;
}

.risk-meta .chevron {
  display: none;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-btn {
  width: 260rpx;
}

.undo-snackbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 148rpx);
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 0 18rpx 0 24rpx;
  border-radius: 20rpx;
  background: rgba(17, 24, 39, 0.94);
  color: #FFFFFF;
  font-size: 26rpx;
  box-shadow: 0 14rpx 34rpx rgba(17, 24, 39, 0.22);
}

.undo-btn {
  width: 108rpx;
  height: 58rpx;
  margin-left: 18rpx;
  padding: 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 58rpx;
}

@keyframes shimmer {
  100% {
    transform: translateX(100%);
  }
}
