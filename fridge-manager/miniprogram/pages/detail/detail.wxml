<!--pages/detail/detail.wxml - 食物详情页-->
<view class="container" wx:if="{{loading}}">
  <view class="detail-skeleton-title skeleton-line skeleton-line-large mb-16"></view>
  <view class="detail-skeleton-subtitle skeleton-line skeleton-line-medium mb-32"></view>

  <view class="card summary-card skeleton-card mb-32">
    <view class="summary-top">
      <view class="summary-icon skeleton-avatar"></view>
      <view class="summary-main">
        <view class="skeleton-line skeleton-line-medium mb-8"></view>
        <view class="skeleton-line skeleton-line-small"></view>
      </view>
    </view>
    <view class="summary-bottom">
      <view class="skeleton-line skeleton-line-small mb-8"></view>
      <view class="skeleton-line skeleton-line-medium"></view>
    </view>
  </view>

  <view class="list-group">
    <view class="list-cell" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="list-main">
        <view class="skeleton-line skeleton-line-medium mb-8"></view>
        <view class="skeleton-line skeleton-line-small"></view>
      </view>
    </view>
  </view>
</view>

<view class="container" wx:elif="{{food}}">
  <text class="large-title">{{food.name}}</text>
  <view class="page-summary-row">
    <text class="page-subtitle page-subtitle-inline">{{food.category}} · {{getLocationText(food.location)}}</text>
    <text class="refresh-state {{actingType ? 'loading' : ''}}">{{actingType === 'delete' ? '删除中' : actingType === 'eat' ? '处理中' : '已同步'}}</text>
  </view>

  <view class="card summary-card">
    <view class="summary-top">
      <view class="summary-icon">
        <text>{{getCategoryIcon(food.category)}}</text>
      </view>
      <view class="summary-main">
        <text class="summary-name">{{food.name}}</text>
        <text class="summary-meta">{{food.category}}</text>
      </view>
      <view class="status-tag status-{{daysResult.type}}">{{daysResult.text}}</view>
    </view>

    <view class="summary-bottom">
      <text class="summary-label">预计到期</text>
      <text class="summary-date">{{food.expiry_date}}</text>
    </view>
  </view>

  <view class="section-header detail-section-header">
    <text class="section-title">基本信息</text>
  </view>
  <view class="list-group">
    <view class="list-cell">
      <view class="list-main">
        <text class="list-title">存放位置</text>
        <text class="list-subtitle">当前保存方式</text>
      </view>
      <text class="row-value">{{getLocationText(food.location)}}</text>
    </view>
    <view class="list-cell">
      <view class="list-main">
        <text class="list-title">放入日期</text>
        <text class="list-subtitle">进入冰箱的时间</text>
      </view>
      <text class="row-value">{{food.put_date}}</text>
    </view>
    <view class="list-cell">
      <view class="list-main">
        <text class="list-title">保质期</text>
        <text class="list-subtitle">系统按此计算到期时间</text>
      </view>
      <text class="row-value">{{food.shelf_life_days}} 天</text>
    </view>
  </view>

  <view class="section-header detail-section-header" wx:if="{{food.notes}}">
    <text class="section-title">备注</text>
  </view>
  <view class="card notes-card" wx:if="{{food.notes}}">
    <text class="notes-text">{{food.notes}}</text>
  </view>

  <view class="action-row">
    <button class="btn btn-outline half-btn" bindtap="editFood" disabled="{{!!actingType}}">编辑</button>
    <button class="btn btn-danger half-btn" bindtap="deleteFood" disabled="{{!!actingType}}">{{actingType === 'delete' ? '删除中...' : '删除'}}</button>
  </view>

  <button class="btn btn-success" bindtap="markAsEaten" disabled="{{!!actingType}}">{{actingType === 'eat' ? '处理中...' : '标记为已吃完'}}</button>
</view>
<view class="container" wx:else>
  <view class="loading card">
    <text class="loading-text">加载中...</text>
  </view>
</view>
