/* pages/detail/detail.wxss */

.page-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.page-subtitle-inline {
  margin-bottom: 0;
}

.skeleton-card {
  background: #FFFFFF;
}

.skeleton-line,
.skeleton-avatar {
  position: relative;
  overflow: hidden;
  background: #ECECF1;
}

.skeleton-line::after,
.skeleton-avatar::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.7) 50%, rgba(255,255,255,0) 100%);
  animation: shimmer 1.4s infinite;
}

.detail-skeleton-title {
  width: 240rpx;
  height: 72rpx;
  border-radius: 24rpx;
}

.detail-skeleton-subtitle {
  width: 320rpx;
  height: 24rpx;
  border-radius: 999rpx;
}

.skeleton-line-small {
  width: 180rpx;
  height: 24rpx;
  border-radius: 999rpx;
}

.skeleton-line-medium {
  width: 260rpx;
  height: 24rpx;
  border-radius: 999rpx;
}

.skeleton-line-large {
  width: 140rpx;
  height: 72rpx;
  border-radius: 24rpx;
}

.skeleton-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
}

.summary-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #F8FBFF 100%);
}

.detail-food-image {
  width: 100%;
  height: 360rpx;
  margin-bottom: 28rpx;
  border-radius: 22rpx;
  background: var(--surface-muted);
}

.summary-top {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.summary-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: var(--surface-muted);
  font-size: 56rpx;
}

.summary-main {
  flex: 1;
}

.summary-name {
  display: block;
  margin-bottom: 6rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.summary-meta {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.summary-bottom {
  padding-top: 24rpx;
  border-top: 1px solid var(--cell-border);
}

.summary-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.summary-date {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.detail-section-header {
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.location-recalc-card {
  padding: 28rpx;
}

.location-recalc-header {
  padding: 0;
}

.location-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.location-option {
  padding: 18rpx 10rpx;
  border-radius: 20rpx;
  background: #F6F7F9;
  border: 2rpx solid transparent;
  text-align: center;
}

.location-option.active {
  background: #EEF6FF;
  border-color: rgba(0, 122, 255, 0.42);
}

.location-option-title,
.location-option-days {
  display: block;
}

.location-option-title {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.location-option-days {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.location-tip {
  display: block;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #F2F8F5;
  color: #1F7A3B;
  font-size: 24rpx;
  line-height: 1.4;
}

.row-value {
  margin-left: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.notes-card {
  line-height: 1.7;
}

.notes-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.detail-delete-btn {
  margin-bottom: 20rpx;
}

@keyframes shimmer {
  100% {
    transform: translateX(100%);
  }
}
