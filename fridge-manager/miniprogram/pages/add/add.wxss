/* pages/add/add.wxss */
/* 核心风格优化点：圆角柔边表单、标签式选择、主色渐变提交按钮、充足留白的食材录入流程。 */

.add-page { padding-bottom: 300rpx; }

.page-summary-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 32rpx;
}

.capture-header,
.result-header,
.form-header { padding: 0; margin-bottom: 20rpx; }

.capture-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.capture-card { background: linear-gradient(180deg, #FFFDF7 0%, #EEF8F2 100%); }

.reset-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 136rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.86);
  border: 2rpx solid rgba(149, 210, 179, 0.34);
  color: var(--primary-deep);
  font-size: 24rpx;
  font-weight: 750;
  line-height: 56rpx;
  box-shadow: 0 8rpx 18rpx rgba(73, 80, 87, 0.06);
}

.reset-add-btn:active {
  opacity: 0.78;
  transform: scale(0.97);
}

.reset-add-btn[disabled] {
  opacity: 0.46;
}

.camera-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  border-radius: 20rpx;
  background: radial-gradient(circle at 50% 30%, rgba(149, 210, 179, 0.18) 0, rgba(149, 210, 179, 0) 170rpx), linear-gradient(180deg, rgba(255, 253, 247, 0.88) 0%, rgba(242, 238, 223, 0.70) 100%);
  border: 3rpx dashed rgba(149, 210, 179, 0.48);
  box-shadow: inset 0 6rpx 20rpx rgba(73, 80, 87, 0.04);
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.camera-panel:active { opacity: 0.86; transform: scale(0.985); }

.camera-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 18rpx;
  border-radius: 34rpx;
  background: rgba(255, 253, 247, 0.78);
  border: 2rpx solid rgba(149, 210, 179, 0.34);
  font-size: 62rpx;
}

.camera-title { margin-bottom: 8rpx; color: var(--text-primary); font-size: 32rpx; font-weight: 750; }
.camera-subtitle { color: var(--text-secondary); font-size: 24rpx; }

.image-preview { position: relative; overflow: hidden; border-radius: 20rpx; background: var(--surface-muted); }
.preview-image { width: 100%; height: 420rpx; border-radius: 20rpx; background: var(--surface-muted); }

.processing-banner {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(73, 80, 87, 0.78);
  color: #FFFFFF;
}

.processing-title { display: block; font-size: 28rpx; font-weight: 700; }

.empty-recognition-card {
  background: linear-gradient(180deg, #FFFDF7 0%, rgba(245, 184, 110, 0.12) 100%);
  border-color: rgba(245, 184, 110, 0.26);
}

.empty-recognition-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 14rpx;
  border-radius: 50%;
  background: rgba(245, 184, 110, 0.18);
  color: #A76420;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-recognition-title { display: block; margin-bottom: 8rpx; color: var(--text-primary); font-size: 30rpx; font-weight: 700; }
.empty-recognition-actions { display: flex; margin-top: 20rpx; }
.empty-recognition-actions .mini-btn { margin-right: 12rpx; margin-left: 0; }

.result-scroll { max-height: 480rpx; border-radius: 20rpx; background: rgba(242, 238, 223, 0.56); }
.entry-mode-card,
.selected-editor-card,
.quick-add-card { padding: 28rpx; }

.entry-mode-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.entry-mode-option,
.decision-option,
.location-like-option {
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 253, 247, 0.78);
  border: 2rpx solid var(--neutral-light);
  box-sizing: border-box;
  text-align: center;
  transition: opacity 0.16s ease, transform 0.16s ease;
}
.entry-mode-option:active,
.decision-option:active { opacity: 0.84; transform: scale(0.98); }
.entry-mode-option.active,
.decision-option.active { background: rgba(149, 210, 179, 0.18); border-color: rgba(149, 210, 179, 0.52); }
.entry-mode-title { display: block; color: var(--text-primary); font-size: 28rpx; font-weight: 750; }

.result-cell {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 22rpx 24rpx;
  background: rgba(255, 253, 247, 0.96);
  border-bottom: 1px solid var(--cell-border);
  box-sizing: border-box;
}
.result-cell:last-child { border-bottom: none; }
.result-cell.active { background: rgba(149, 210, 179, 0.16); }
.result-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #FFFDF7;
  border: 2rpx solid rgba(149, 210, 179, 0.52);
  color: var(--primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}
.result-thumb,
.result-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 253, 247, 0.76);
  border: 2rpx solid rgba(149, 210, 179, 0.26);
  font-size: 32rpx;
}
.result-thumb { overflow: hidden; padding: 0; }
.result-thumb-image { width: 54rpx; height: 54rpx; }
.result-state { margin-left: 16rpx; color: var(--primary-deep); font-size: 24rpx; font-weight: 700; }
.freshness-row { display: flex; align-items: center; margin-top: 8rpx; }
.freshness-chip {
  display: inline-flex;
  align-items: center;
  max-width: 240rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(149, 210, 179, 0.16);
  color: var(--primary-deep);
  font-size: 20rpx;
  font-weight: 700;
}
.freshness-normal { background: rgba(245, 184, 110, 0.16); color: #A76420; }
.freshness-stale { background: rgba(255, 149, 0, 0.18); color: #A85B00; }
.freshness-spoiled { background: rgba(216, 100, 100, 0.16); color: var(--danger-color); }

.quick-add-card { background: linear-gradient(180deg, #FFFDF7 0%, rgba(149, 210, 179, 0.12) 100%); }
.quick-add-header { padding: 0; }
.quick-food-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.quick-food-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 74rpx;
  padding: 12rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.88);
  border: 2rpx solid rgba(149, 210, 179, 0.24);
  box-sizing: border-box;
  transition: opacity 0.16s ease, transform 0.16s ease;
}
.quick-food-chip:active { opacity: 0.84; transform: scale(0.98); }
.quick-food-icon { margin-right: 8rpx; font-size: 28rpx; }
.quick-food-name { color: var(--text-primary); font-size: 24rpx; font-weight: 750; }

.selected-scroll { max-height: 460rpx; }
.selected-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  margin-bottom: 12rpx;
  padding: 14rpx 12rpx 14rpx 14rpx;
  background: rgba(255, 253, 247, 0.92);
  border: 1rpx solid rgba(173, 181, 189, 0.18);
  border-radius: 20rpx;
  box-sizing: border-box;
}
.selected-item:last-child { margin-bottom: 0; }
.selected-item:active { background: #F2EEDF; }
.selected-thumb,
.editor-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(149, 210, 179, 0.14);
  border: 1rpx solid rgba(149, 210, 179, 0.26);
  overflow: hidden;
}
.selected-thumb { width: 72rpx; height: 72rpx; margin-right: 16rpx; border-radius: 18rpx; }
.selected-thumb-image { width: 72rpx; height: 72rpx; }
.selected-thumb-image.muted,
.editor-preview-image.muted { opacity: 0.66; }
.selected-thumb-icon { font-size: 34rpx; }
.selected-main,
.editor-preview-main { flex: 1; min-width: 0; }
.selected-title-row { display: flex; align-items: center; min-width: 0; }
.selected-badge {
  flex-shrink: 0;
  margin-right: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(149, 210, 179, 0.20);
  color: var(--primary-deep);
  font-size: 18rpx;
  font-weight: 800;
}
.selected-title {
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 750;
}
.selected-summary { display: flex; align-items: center; min-width: 0; margin-top: 6rpx; }
.selected-meta,
.selected-dot { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-secondary); font-size: 22rpx; }
.selected-dot { margin: 0 8rpx; }
.freshness-text { color: #A76420; font-weight: 700; }
.explain-chip {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(149, 210, 179, 0.16), rgba(255, 253, 247, 0.82));
  border: 1rpx solid rgba(149, 210, 179, 0.26);
}
.explain-chip-label {
  display: block;
  margin-bottom: 4rpx;
  color: var(--primary-deep);
  font-size: 20rpx;
  font-weight: 800;
}
.explain-chip-text {
  display: block;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.45;
}

.storage-advice,
.decision-expiry {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(149, 210, 179, 0.14);
  border: 1rpx solid rgba(149, 210, 179, 0.28);
}
.storage-advice-text { display: block; color: var(--text-secondary); font-size: 22rpx; line-height: 1.4; }
.storage-explain-text {
  display: block;
  margin-top: 10rpx;
  color: var(--primary-deep);
  font-size: 22rpx;
  line-height: 1.45;
}
.storage-advice-actions { display: flex; margin-top: 14rpx; }
.advice-action,
.mini-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 100rpx;
  height: 54rpx;
  margin-left: 10rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #FFFDF7;
  border: 2rpx solid rgba(149, 210, 179, 0.36);
  color: var(--primary-deep);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 54rpx;
}
.advice-action { min-width: 160rpx; height: 56rpx; margin: 0; font-size: 24rpx; line-height: 56rpx; }
.mini-btn:active { opacity: 0.78; transform: scale(0.96); }
.mini-btn.danger { border-color: rgba(216, 100, 100, 0.28); color: var(--danger-color); }
.selected-actions { display: flex; align-items: center; justify-content: flex-end; flex-shrink: 0; width: 28rpx; margin-left: 4rpx; }
.selected-delete-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-left: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--neutral-mid);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 28rpx;
  box-sizing: border-box;
}
.selected-delete-btn:active { background: rgba(216, 100, 100, 0.10); color: var(--danger-color); }
.picker-display { display: flex; align-items: center; justify-content: space-between; }
.submit-btn { margin-bottom: 32rpx; }

.batch-bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 154rpx);
  left: 24rpx;
  z-index: 980;
  display: flex;
  align-items: center;
  padding: 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 253, 247, 0.98);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 16rpx 44rpx rgba(73, 80, 87, 0.16);
  box-sizing: border-box;
}
.batch-info { flex: 1; min-width: 0; padding-left: 8rpx; }
.batch-count { display: block; margin-bottom: 4rpx; color: var(--text-primary); font-size: 30rpx; font-weight: 780; }
.batch-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 196rpx;
  height: 76rpx;
  margin-left: 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #AEE0C4 0%, #95D2B3 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 750;
  box-shadow: var(--soft-shadow);
}
.batch-submit[disabled] { opacity: 0.5; }

.editor-overlay,
.decision-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  background: rgba(73, 80, 87, 0.34);
}
.decision-overlay { z-index: 1300; }
.editor-sheet,
.decision-sheet {
  width: 100%;
  max-height: 88vh;
  padding: 16rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-radius: 32rpx 32rpx 0 0;
  background: linear-gradient(180deg, #FFFDF7 0%, #F8F4E9 100%);
  box-shadow: 0 -16rpx 40rpx rgba(73, 80, 87, 0.12);
  box-sizing: border-box;
}
.editor-sheet {
  display: flex;
  flex-direction: column;
  height: 86vh;
  overflow: hidden;
}
.decision-sheet { max-height: 86vh; padding-bottom: calc(env(safe-area-inset-bottom) + 30rpx); }
.editor-handle { width: 72rpx; height: 8rpx; margin: 0 auto 22rpx; border-radius: 999rpx; background: rgba(173, 181, 189, 0.62); }
.editor-header,
.decision-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24rpx; }
.decision-header { margin-bottom: 22rpx; }
.editor-title,
.decision-title { display: block; margin-bottom: 6rpx; color: var(--text-primary); font-size: 36rpx; font-weight: 780; }
.decision-title { margin: 0; font-size: 40rpx; font-weight: 800; }
.decision-freshness { display: block; margin-top: 8rpx; color: #A76420; font-size: 22rpx; line-height: 1.4; }
.editor-header-save {
  width: auto;
  min-width: 112rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #AEE0C4 0%, #95D2B3 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 58rpx;
  box-shadow: var(--soft-shadow);
}
.editor-header-save[disabled] { opacity: 0.5; }
.editor-scroll {
  flex: 1;
  min-height: 0;
  max-height: 100%;
  box-sizing: border-box;
}
.editor-preview-row { display: flex; align-items: center; margin-bottom: 24rpx; padding: 20rpx; border-radius: 20rpx; background: rgba(242, 238, 223, 0.68); }
.editor-preview { width: 128rpx; height: 128rpx; margin-right: 20rpx; border-radius: 20rpx; background: #FFFDF7; }
.editor-preview-image { width: 128rpx; height: 128rpx; }
.editor-preview-title { display: block; margin-bottom: 6rpx; color: var(--text-primary); font-size: 28rpx; font-weight: 750; }
.editor-freshness { display: block; margin-bottom: 10rpx; color: #A76420; font-size: 22rpx; line-height: 1.4; }
.editor-crop-btn { margin-left: 0; }
.editor-fields { margin-bottom: 24rpx; }
.editor-notes { min-height: 128rpx; }
.editor-actions {
  display: flex;
  flex-shrink: 0;
  justify-content: space-between;
  padding-top: 18rpx;
  background: linear-gradient(180deg, rgba(248, 244, 233, 0) 0%, #F8F4E9 34%, #F8F4E9 100%);
}
.editor-action-btn { width: 48%; height: 84rpx; }

.decision-image { width: 100%; height: 280rpx; margin-bottom: 20rpx; border-radius: 20rpx; background: var(--surface-muted); }
.decision-toggle { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-bottom: 20rpx; }
.decision-option { padding: 18rpx 10rpx; }
.decision-option-main,
.decision-option-sub { display: block; }
.decision-option-main { margin-bottom: 8rpx; color: var(--text-primary); font-size: 24rpx; font-weight: 750; }
.decision-option-sub { color: var(--text-secondary); font-size: 22rpx; }
.decision-expiry { display: flex; align-items: center; justify-content: space-between; margin-top: 0; margin-bottom: 18rpx; padding: 22rpx 24rpx; }
.decision-expiry-label { color: var(--text-secondary); font-size: 24rpx; }
.decision-expiry-date { color: var(--primary-deep); font-size: 32rpx; font-weight: 800; }
.decision-explain {
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 253, 247, 0.88);
  border: 1rpx solid rgba(149, 210, 179, 0.26);
}
.decision-explain-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}
.decision-explain-text {
  display: block;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}
.decision-primary { height: 88rpx; margin-bottom: 12rpx; }
.decision-secondary { height: 72rpx; padding: 0; background: transparent; color: var(--primary-deep); font-size: 26rpx; line-height: 72rpx; }
