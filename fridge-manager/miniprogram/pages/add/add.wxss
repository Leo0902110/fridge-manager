/* pages/add/add.wxss */

.page-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.page-subtitle-inline {
  margin-bottom: 0;
}

.capture-header,
.result-header,
.form-header {
  padding: 0;
  margin-bottom: 20rpx;
}

.camera-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FAFBFF 0%, #F1F4FA 100%);
  border: 2rpx dashed rgba(0, 122, 255, 0.24);
}

.camera-icon {
  font-size: 80rpx;
  margin-bottom: 18rpx;
}

.camera-title {
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.camera-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.image-preview {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
}

.preview-image {
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  background: #000000;
}

.preview-toolbar {
  margin-top: 20rpx;
}

.processing-banner {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 120rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(17, 17, 17, 0.78);
  color: #FFFFFF;
}

.processing-title {
  display: block;
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.processing-subtitle {
  font-size: 22rpx;
  opacity: 0.86;
}

.preview-btn {
  height: 84rpx;
}

.empty-recognition-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF9F0 100%);
}

.empty-recognition-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-recognition-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.result-scroll {
  max-height: 480rpx;
  border-radius: 20rpx;
  background: var(--surface-muted);
}

.result-cell {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-bottom: 1px solid var(--cell-border);
}

.result-cell:last-child {
  border-bottom: none;
}

.result-cell.active {
  background: rgba(0, 122, 255, 0.08);
}

.result-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid rgba(0, 122, 255, 0.35);
  color: var(--primary-color);
  font-size: 24rpx;
  font-weight: 700;
}

.result-icon {
  margin-right: 18rpx;
  font-size: 38rpx;
}

.result-state {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.selected-editor-card {
  padding-bottom: 24rpx;
}

.selected-scroll {
  max-height: 760rpx;
}

.selected-item {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: var(--surface-muted);
}

.selected-item:last-child {
  margin-bottom: 0;
}

.selected-item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.selected-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.selected-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: rgba(0, 122, 255, 0.12);
  color: var(--primary-color);
  font-size: 24rpx;
  font-weight: 700;
}

.selected-title {
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.selected-actions {
  display: flex;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.mini-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 96rpx;
  height: 52rpx;
  margin-left: 10rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(0, 122, 255, 0.22);
  color: var(--primary-color);
  font-size: 22rpx;
  line-height: 52rpx;
}

.mini-btn.danger {
  border-color: rgba(255, 59, 48, 0.22);
  color: var(--danger-color);
}

.selected-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.mini-field {
  min-width: 0;
}

.mini-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.mini-control {
  width: 100%;
  min-height: 72rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--text-primary);
}

.mini-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.selected-crop-preview {
  width: 128rpx;
  height: 128rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
}

.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.submit-btn {
  margin-bottom: 32rpx;
}
