/* pages/add/add.wxss */

.add-page {
  padding-bottom: 300rpx;
}

.page-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.page-subtitle-inline {
  margin-bottom: 0;
}

.capture-header,
.result-header,
.form-header {
  padding: 0;
  margin-bottom: 20rpx;
}

.camera-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FAFBFF 0%, #F1F4FA 100%);
  border: 2rpx dashed rgba(0, 122, 255, 0.24);
}

.camera-icon {
  font-size: 80rpx;
  margin-bottom: 18rpx;
}

.camera-title {
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.camera-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.image-preview {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
}

.preview-image {
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  background: #000000;
}

.preview-toolbar {
  margin-top: 20rpx;
}

.processing-banner {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 120rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(17, 17, 17, 0.78);
  color: #FFFFFF;
}

.processing-title {
  display: block;
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.processing-subtitle {
  font-size: 22rpx;
  opacity: 0.86;
}

.preview-btn {
  height: 84rpx;
}

.empty-recognition-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF9F0 100%);
}

.empty-recognition-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-recognition-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.result-scroll {
  max-height: 480rpx;
  border-radius: 20rpx;
  background: var(--surface-muted);
}

.entry-mode-card {
  padding: 28rpx;
}

.entry-mode-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.entry-mode-option {
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background: #F6F7F9;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.entry-mode-option.active {
  background: #EEF6FF;
  border-color: rgba(0, 122, 255, 0.38);
}

.entry-mode-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.entry-mode-subtitle {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.35;
}

.result-cell {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-bottom: 1px solid var(--cell-border);
}

.result-cell:last-child {
  border-bottom: none;
}

.result-cell.active {
  background: rgba(0, 122, 255, 0.08);
}

.result-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid rgba(0, 122, 255, 0.35);
  color: var(--primary-color);
  font-size: 24rpx;
  font-weight: 700;
}

.result-icon {
  margin-right: 18rpx;
  font-size: 38rpx;
}

.result-state {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.selected-editor-card {
  padding: 28rpx;
}

.selected-scroll {
  max-height: 520rpx;
}

.selected-item {
  display: flex;
  align-items: center;
  min-height: 128rpx;
  margin-bottom: 16rpx;
  padding: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
}

.selected-item:last-child {
  margin-bottom: 0;
}

.selected-item:active {
  background: #F4F7FB;
}

.selected-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: #EEF5FF;
  overflow: hidden;
}

.selected-thumb-image {
  width: 92rpx;
  height: 92rpx;
}

.selected-thumb-image.muted {
  opacity: 0.66;
}

.selected-thumb-icon {
  font-size: 42rpx;
}

.selected-main {
  flex: 1;
  min-width: 0;
}

.selected-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.selected-badge {
  flex-shrink: 0;
  margin-right: 10rpx;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.1);
  color: var(--primary-color);
  font-size: 20rpx;
  font-weight: 700;
}

.selected-title {
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.selected-meta-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  min-width: 0;
}

.selected-meta,
.selected-dot {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.selected-dot {
  margin: 0 8rpx;
}

.selected-image-chip {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(142, 142, 147, 0.12);
  color: var(--text-secondary);
  font-size: 20rpx;
  font-weight: 700;
}

.selected-image-chip.done {
  background: rgba(52, 199, 89, 0.12);
  color: #2E7D32;
}

.selected-storage-chip {
  flex-shrink: 0;
  margin-right: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(52, 199, 89, 0.12);
  color: #2E7D32;
  font-size: 20rpx;
  font-weight: 700;
}

.selected-storage-tip {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.storage-advice {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #F2F8F5;
  border: 1rpx solid rgba(52, 199, 89, 0.16);
}

.storage-advice-title {
  display: block;
  margin-bottom: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1F7A3B;
}

.storage-advice-text {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.selected-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 14rpx;
}

.mini-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 96rpx;
  height: 52rpx;
  margin-left: 10rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(0, 122, 255, 0.22);
  color: var(--primary-color);
  font-size: 22rpx;
  line-height: 52rpx;
}

.mini-btn:active,
.mini-icon-btn:active {
  opacity: 0.75;
  transform: scale(0.96);
}

.mini-btn.danger {
  border-color: rgba(255, 59, 48, 0.22);
  color: var(--danger-color);
}

.mini-icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 10rpx;
  padding: 0;
  border-radius: 50%;
  background: #F2F2F7;
  color: var(--text-secondary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.mini-icon-btn.danger {
  background: rgba(255, 59, 48, 0.08);
  color: var(--danger-color);
}

.selected-chevron {
  margin-left: 12rpx;
  color: #C7C7CC;
  font-size: 34rpx;
  line-height: 1;
}

.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.submit-btn {
  margin-bottom: 32rpx;
}

.batch-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 154rpx);
  z-index: 980;
  display: flex;
  align-items: center;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  box-shadow: 0 16rpx 44rpx rgba(17, 24, 39, 0.16);
  box-sizing: border-box;
}

.batch-info {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}

.batch-count {
  display: block;
  margin-bottom: 4rpx;
  font-size: 30rpx;
  font-weight: 750;
  color: var(--text-primary);
}

.batch-caption {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.batch-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 196rpx;
  height: 76rpx;
  margin-left: 18rpx;
  border-radius: 18rpx;
  background: var(--primary-color);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(0, 122, 255, 0.22);
}

.batch-submit[disabled] {
  opacity: 0.5;
}

.editor-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 39, 0.34);
}

.editor-sheet {
  width: 100%;
  max-height: 88vh;
  padding: 16rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-radius: 30rpx 30rpx 0 0;
  background: #FFFFFF;
  box-sizing: border-box;
}

.editor-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #D1D1D6;
}

.editor-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.editor-title {
  display: block;
  margin-bottom: 6rpx;
  font-size: 36rpx;
  font-weight: 750;
  color: var(--text-primary);
}

.editor-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.editor-preview-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: var(--surface-muted);
}

.editor-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  overflow: hidden;
}

.editor-preview-image {
  width: 128rpx;
  height: 128rpx;
}

.editor-preview-image.muted {
  opacity: 0.62;
}

.editor-preview-main {
  flex: 1;
  min-width: 0;
}

.editor-preview-title {
  display: block;
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.editor-preview-caption {
  display: block;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.editor-crop-btn {
  margin-left: 0;
}

.editor-fields {
  margin-bottom: 24rpx;
}

.editor-notes {
  min-height: 128rpx;
}

.editor-actions {
  display: flex;
  justify-content: space-between;
}

.editor-action-btn {
  width: 48%;
  height: 84rpx;
}
